{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "renovate",
    "dependencies"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Helm chart versions in blueprint YAML files (HTTP repositories)",
      "managerFilePatterns": [
        "/^charts/[^.]+\\.yaml$/"
      ],
      "matchStrings": [
        "url: (?<registryUrl>https://[^\\n]+)[\\s\\S]+?name: (?:[^/\\n]+)/(?<depName>[^\\n]+)\\s+version: \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "helm",
      "versioningTemplate": "helm"
    },
    {
      "customType": "regex",
      "description": "Update OCI Helm chart versions in blueprint YAML files",
      "managerFilePatterns": [
        "/^charts/[^.]+\\.yaml$/"
      ],
      "matchStrings": [
        "url: oci://(?<registryUrl>[^\\n]+)[\\s\\S]+?name: (?:[^/\\n]+)/(?<depName>[^\\n]+)\\s+version: \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "{{registryUrl}}/{{depName}}",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Group all blueprint updates into a single PR",
      "matchFileNames": [
        "charts/*.yaml"
      ],
      "groupName": "helm chart blueprints",
      "groupSlug": "helm-blueprints"
    }
  ]
}
